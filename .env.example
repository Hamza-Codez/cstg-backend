# Copy to .env and adjust. Settings are read by app/config.py with the APP_ prefix.

APP_ENV=production

# JWT signing key. The code ships a development default that is public in this
# repository, so the app REFUSES to start with APP_ENV=production unless this is
# set to a unique value of at least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_SECRET_KEY=
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support

# deployment
DATABASE_URL=postgresql://postgres:YxBndiqCeTjqLboVeDCZLOwbvvHeiWSj@postgres.railway.internal:5432/railway


# SLA monitor scan interval (seconds). Consumed from P5 onward; see docs/ARCHITECTURE.md §6.
APP_SLA_SCAN_INTERVAL_SECONDS=30
